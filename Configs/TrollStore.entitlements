<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- MT-Agent uses these private entitlements for TrollStore execution.
	     persona-mgmt is required by posix_spawnattr_set_persona_np(99, ...),
	     which is how runtime tools are launched as root persona. -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.private.persona-mgmt</key>
	<true/>
	<key>com.apple.springboard.debugapplications</key>
	<true/>
	<key>application-identifier</key>
	<string>com.openminis.app</string>
	<key>com.apple.developer.team-identifier</key>
	<string>OPENMINIS</string>
	<key>get-task-allow</key>
	<true/>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.openminis.app</string>
	</array>
	<key>com.apple.private.background-task.allowed</key>
	<true/>
	<key>task_for_pid-allow</key>
	<true/>
	<key>proc_info-allow</key>
	<true/>
	<!-- [T-spawn-entitlements] 只加这一项：Theos runtime 里的二进制是设备上现场
	     下载、现场 ldid 签的，CDHash 与主程序不同，dyld 默认按 team id 校验会直接
	     拒绝加载 —— 这才是「无法启动进程 / Library not loaded」的常见真因。

	     刻意不加的两项（上一轮加过，导致启动即闪退）：
	       com.apple.private.security.storage.MobileDocuments —— 这是 iCloud 文档
	         容器权限，没有配套的 com.apple.developer.icloud-container-identifiers
	         时，启动阶段容器解析失败会直接把进程杀掉，且不留下 .ips。
	       dynamic-codesigning —— JIT 相关。本工程的 AOT 运行时明确不需要 JIT
	         （见 build_ish.sh 的 -Djit=false 说明），加上只会提高被杀风险。 -->
	<key>com.apple.private.skip-library-validation</key>
	<true/>
</dict>
</plist>
